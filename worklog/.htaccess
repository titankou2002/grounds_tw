# Disable caching for index.html so mobile devices always get the latest version
<FilesMatch "^(index|map)\.html$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ---- 密碼閘門：所有請求都先經過 gate.php（登入後 cookie 記住一年） ----
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/gate\.php$
    RewriteRule ^ gate.php [L]
</IfModule>
