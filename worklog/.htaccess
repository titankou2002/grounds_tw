# Disable caching for index.html so mobile devices always get the latest version
<FilesMatch "^(index|map|share|report)\.html$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# 2026-11-16 已取消密碼閘門（gate.php 已刪除），所有頁面與 API 公開。
# 隱藏檔（.wl_anthropic_key 等金鑰）、鎖檔、暫存檔一律擋掉
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(lock|md)$|\.tmp\.">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
